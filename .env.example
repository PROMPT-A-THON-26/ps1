# Vault storage node identity and listener
VAULT_NODE_ID=node-01
VAULT_NODE_HOST=0.0.0.0
VAULT_NODE_PORT=9001

# Logical Vault object-storage capacity limit for this node
VAULT_NODE_CAPACITY_BYTES=107374182400
VAULT_NODE_CHUNK_SIZE_BYTES=16777216
VAULT_NODE_DATA_DIR=/data/vault

# Durable local SQLite node-state database.
# Keep this outside VAULT_NODE_DATA_DIR so it is not part of object storage accounting.
VAULT_NODE_SQLITE_PATH=/var/lib/vault/node_state.sqlite3

# PostgreSQL — authoritative relational metadata store
POSTGRES_DB=vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional explicit client DSN; when omitted, the POSTGRES_* values above are used.
# VAULT_POSTGRES_DSN=postgresql://vault:vault-dev-password@postgres:5432/vault

# MongoDB — document/event store
MONGO_INITDB_ROOT_USERNAME=vault
MONGO_INITDB_ROOT_PASSWORD=vault-dev-password
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=vault

# Optional explicit Mongo URI; when omitted, the MONGO_* values above are used.
# VAULT_MONGO_URI=mongodb://vault:vault-dev-password@mongodb:27017/?authSource=admin
# VAULT_MONGO_DATABASE=vault
