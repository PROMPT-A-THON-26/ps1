# Storage node
VAULT_NODE_ID=node-01
VAULT_NODE_HOST=0.0.0.0
VAULT_NODE_PORT=9001
VAULT_NODE_CAPACITY_BYTES=107374182400
VAULT_NODE_CHUNK_SIZE_BYTES=16777216
VAULT_NODE_DATA_DIR=/data/vault
VAULT_NODE_SQLITE_PATH=/var/lib/vault/node_state.sqlite3

# Authoritative PostgreSQL metadata
POSTGRES_DB=vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vault:vault-dev-password@postgres:5432/vault

# MongoDB operational/event documents
MONGO_INITDB_ROOT_USERNAME=vault
MONGO_INITDB_ROOT_PASSWORD=vault-dev-password
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=vault
VAULT_MONGO_URI=mongodb://vault:vault-dev-password@mongodb:27017/?authSource=admin
VAULT_MONGO_DATABASE=vault

# Durability policy
REPLICATION_FACTOR=3
WRITE_QUORUM=2
READ_QUORUM=1
CHUNK_SIZE_MB=16

# Failure detection / repair policy
HEARTBEAT_INTERVAL_SECONDS=5
SUSPECT_AFTER_SECONDS=15
UNAVAILABLE_AFTER_SECONDS=30
MAX_PARALLEL_REPAIRS=4

# Reliability worker runtime
VAULT_STORAGE_NODES=node-01=http://localhost:9001,node-02=http://localhost:9002,node-03=http://localhost:9003,node-04=http://localhost:9004
RELIABILITY_INTERVAL_SECONDS=5
REPAIR_BATCH_SIZE=16
INTEGRITY_BATCH_SIZE=
REBALANCE_HIGH_WATERMARK=0.80
REBALANCE_LOW_WATERMARK=0.60
REBALANCE_MAX_MOVES_PER_SCAN=8
