# Storage node identity and listener (shared with Part A)
VAULT_NODE_ID=node-01
VAULT_NODE_HOST=0.0.0.0
VAULT_NODE_PORT=9001
VAULT_NODE_CAPACITY_BYTES=107374182400
VAULT_NODE_DATA_DIR=/data/vault

# Control-plane PostgreSQL
DATABASE_URL=postgresql+psycopg://vault:vault@postgres:5432/vault
SQL_ECHO=0

# Durability policy
VAULT_REPLICATION_FACTOR=3
VAULT_WRITE_QUORUM=2
VAULT_READ_QUORUM=1
CHUNK_SIZE_MB=16

# Health policy
VAULT_HEARTBEAT_INTERVAL_SECONDS=5
VAULT_SUSPECT_AFTER_SECONDS=15
VAULT_UNAVAILABLE_AFTER_SECONDS=30

# Background jobs
VAULT_MAX_CONCURRENT_JOBS=4
VAULT_MAX_ATTEMPTS=5
VAULT_INITIAL_BACKOFF_SECONDS=2
VAULT_INTEGRITY_SCAN_INTERVAL_SECONDS=3600
VAULT_UNDER_REPLICATION_SCAN_INTERVAL_SECONDS=30
VAULT_REBALANCE_SCAN_INTERVAL_SECONDS=30
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage client
VAULT_STORAGE_REQUEST_TIMEOUT_SECONDS=30
