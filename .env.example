# Storage node identity and listener (shared with Part A)
VAULT_NODE_ID=node-01
VAULT_NODE_HOST=0.0.0.0
VAULT_NODE_PORT=9001
VAULT_NODE_CAPACITY_BYTES=107374182400
VAULT_NODE_DATA_DIR=/data/vault

# Control-plane PostgreSQL credentials (set real values locally; never commit them)
POSTGRES_USER=vault
POSTGRES_PASSWORD=<set-a-strong-password>
DATABASE_URL=postgresql+psycopg://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@postgres:5432/vault
SQL_ECHO=0

# Redis credentials (set real values locally; never commit them)
REDIS_PASSWORD=<set-a-strong-password>
CELERY_BROKER_URL=redis://:$${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:$${REDIS_PASSWORD}@redis:6379/1

# Durability policy
REPLICATION_FACTOR=3
WRITE_QUORUM=2
READ_QUORUM=1
CHUNK_SIZE_MB=16

# Health policy
HEARTBEAT_INTERVAL_SECONDS=5
SUSPECT_AFTER_SECONDS=15
UNAVAILABLE_AFTER_SECONDS=30
MAX_PARALLEL_REPAIRS=4

# Background worker configuration
REPAIR_MAX_ATTEMPTS=5
REPAIR_INITIAL_BACKOFF_SECONDS=2
STORAGE_REQUEST_TIMEOUT_SECONDS=30
INTEGRITY_SCAN_INTERVAL_SECONDS=3600
UNDER_REPLICATED_SCAN_INTERVAL_SECONDS=30

RATE_LIMIT_PER_MINUTE=240
MAX_UPLOAD_BYTES=104857600
VAULT_ADMIN_API_KEY=<set-a-long-random-admin-key>

# End-to-end local gateway/runtime
VAULT_STORAGE_NODES=node-01=http://localhost:9001,node-02=http://localhost:9002,node-03=http://localhost:9003,node-04=http://localhost:9004
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
