# Vault local development environment
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
VAULT_INTERNAL_API_KEY=change-me-internal-api-key
VAULT_ADMIN_API_KEY=change-me-admin-api-key

# Default storage-node settings (for direct/local node execution)
VAULT_NODE_ID=node-01
VAULT_NODE_HOST=0.0.0.0
VAULT_NODE_PORT=9001
VAULT_NODE_CAPACITY_BYTES=10737418240
VAULT_NODE_DATA_DIR=/data/vault

# Control-plane runtime
DATABASE_URL=postgresql+psycopg://vault:change-me-postgres@postgres:5432/vault
SQL_ECHO=0
CELERY_BROKER_URL=redis://:change-me-redis@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-redis@redis:6379/1

# Durability policy
REPLICATION_FACTOR=3
WRITE_QUORUM=2
READ_QUORUM=1
CHUNK_SIZE_MB=16

# Health policy
HEARTBEAT_INTERVAL_SECONDS=5
SUSPECT_AFTER_SECONDS=15
UNAVAILABLE_AFTER_SECONDS=30
MAX_PARALLEL_REPAIRS=4

# Worker configuration
REPAIR_MAX_ATTEMPTS=5
REPAIR_INITIAL_BACKOFF_SECONDS=2
STORAGE_REQUEST_TIMEOUT_SECONDS=30
INTEGRITY_SCAN_INTERVAL_SECONDS=3600
UNDER_REPLICATED_SCAN_INTERVAL_SECONDS=30

RATE_LIMIT_PER_MINUTE=240
MAX_UPLOAD_BYTES=104857600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker-internal storage-node addresses
VAULT_STORAGE_NODES=node-01=http://vault-node-01:9001,node-02=http://vault-node-02:9001,node-03=http://vault-node-03:9001,node-04=http://vault-node-04:9001
