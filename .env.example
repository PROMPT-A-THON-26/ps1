# Storage node identity and listener (shared with Part A)
VAULT_NODE_ID=node-01
VAULT_NODE_HOST=0.0.0.0
VAULT_NODE_PORT=9001
VAULT_NODE_CAPACITY_BYTES=107374182400
VAULT_NODE_DATA_DIR=/data/vault

# Control-plane PostgreSQL
DATABASE_URL=postgresql+psycopg://vault:vault@postgres:5432/vault
SQL_ECHO=0

# Durability policy
REPLICATION_FACTOR=3
WRITE_QUORUM=2
READ_QUORUM=1
CHUNK_SIZE_MB=16

# Health policy
HEARTBEAT_INTERVAL_SECONDS=5
SUSPECT_AFTER_SECONDS=15
UNAVAILABLE_AFTER_SECONDS=30
MAX_PARALLEL_REPAIRS=4
